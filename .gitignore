# ---> Rust
# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

._*

# Exclude documentation, logs, and temporary files
log/
logs/
temp/
tmp/
.cargo/

# Local development tool settings (Claude Code, etc.)
.claude/
AGENTS.md
CLAUDE.md
.codex
.serena

